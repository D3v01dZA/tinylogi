<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>net.caltona.tinylogi</string>
  <key>ProgramArguments</key>
  <array><string>/Applications/Tinylogi.app/Contents/MacOS/tinylogi</string></array>
  <key>RunAtLoad</key><true/>
  <!-- Also restarts it after permissions are granted, since it exits when they are missing. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardErrorPath</key><string>/tmp/tinylogi.log</string>
</dict>
</plist>
